#!/usr/bin/env bash

set -eu
silver() { "../../support/bin/silver" "$@"; }

SRC=..
GRAMMAR=flow

silver -I $SRC --warn-all --dont-translate $@ $GRAMMAR

# Grammars with errors that affect the flow analysis of the whole grammar (captured by
# wrongFlowCode) are compiled on their own.  A regression here is a hang, hence the timeout.
timeout 300 ../../support/bin/silver -I $SRC --warn-all --dont-translate $@ flow:transCycle

# An extension, whose attributes are not known to the host's forwarding productions.
# This recompiles flow as a dependency; a regression in flow type inference is a hang, hence the timeout.
timeout 300 ../../support/bin/silver -I $SRC --warn-all --dont-translate $@ flow:transExt

# A long match with guards, whose failure branches are deeply nested lets.
# A regression in how shared references in lets are checked is exponential time, hence the timeout.
timeout 120 ../../support/bin/silver -I $SRC --warn-all --dont-translate $@ flow:longCase

# The grammar of a dispatch signature, exporting the grammar of an implementation that it applies by name.
silver -I $SRC --warn-all --dont-translate $@ flow:exportedImpl

# Extensions sharing translation attributes of translation attributes in aspects of host productions:
# flow:transShare declares an occurrence on the shared chain, and flow:transShare:orphan does not.
silver -I $SRC --warn-all --dont-translate $@ flow:transShare:orphan
